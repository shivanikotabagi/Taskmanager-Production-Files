# ========================================
# TASKMANAGER DEPLOYMENT CONFIGURATION
# ========================================
# Copy this file to .env and update with your actual values
# For production, use strong passwords and secure secrets

# ── MYSQL DATABASE CONFIGURATION ──────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_to_secure_password
MYSQL_USER=taskmanager
MYSQL_PASSWORD=change_me_to_secure_password
MYSQL_DATABASE=taskmanager_db

# ── SPRING BOOT BACKEND CONFIGURATION ─────────────────────────
# JWT Secret (generate a strong secret in production)
# You can generate with: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Configuration - Update with your frontend domain/IP
CORS_ALLOWED_ORIGINS=http://your-ec2-ip-or-domain:80

# Spring Profile (dev, test, prod)
SPRING_PROFILE=prod

# Java Options for container
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# Backend Port
BACKEND_PORT=8080

# ── REACT FRONTEND CONFIGURATION ──────────────────────────────
# Update with your EC2 instance IP or domain
API_URL=http://your-ec2-ip-or-domain:8080
WS_URL=http://your-ec2-ip-or-domain:8080/ws

# Frontend Port
FRONTEND_PORT=80

# ── PROMETHEUS MONITORING CONFIGURATION ───────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ── NODE EXPORTER CONFIGURATION ───────────────────────────────
NODE_EXPORTER_PORT=9100

# ── GRAFANA CONFIGURATION ────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_secure_password
# Optional: Comma-separated list of plugins to install
GRAFANA_PLUGINS=

# ── DOCKER CONFIGURATION ──────────────────────────────────────
# Images are built locally, no registry needed

# ── ENVIRONMENT ──────────────────────────────────────────────
ENVIRONMENT=production
